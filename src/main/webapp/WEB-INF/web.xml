<?xml version="1.0" encoding="UTF-8"?><web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee" version="4.0">
 <display-name>ZoroMart</display-name><listener><listener-class>com.zoro.zoromart.listener.AppContextListener</listener-class></listener>
 <filter><filter-name>encodingFilter</filter-name><filter-class>com.zoro.zoromart.filter.EncodingFilter</filter-class></filter><filter-mapping><filter-name>encodingFilter</filter-name><url-pattern>/*</url-pattern></filter-mapping>
 <filter><filter-name>requestIdFilter</filter-name><filter-class>com.zoro.zoromart.filter.RequestIdFilter</filter-class></filter><filter-mapping><filter-name>requestIdFilter</filter-name><url-pattern>/*</url-pattern></filter-mapping>
 <filter><filter-name>authFilter</filter-name><filter-class>com.zoro.zoromart.filter.AuthFilter</filter-class></filter><filter-mapping><filter-name>authFilter</filter-name><url-pattern>/api/v1/cart/*</url-pattern></filter-mapping><filter-mapping><filter-name>authFilter</filter-name><url-pattern>/api/v1/orders/*</url-pattern></filter-mapping><filter-mapping><filter-name>authFilter</filter-name><url-pattern>/api/v1/reviews/*</url-pattern></filter-mapping>
 <session-config><session-timeout>30</session-timeout><cookie-config><http-only>true</http-only><secure>false</secure></cookie-config><tracking-mode>COOKIE</tracking-mode></session-config>
 <error-page><error-code>404</error-code><location>/error.html</location></error-page><error-page><error-code>500</error-code><location>/error.html</location></error-page>
</web-app>
